# HireIQ — local dev secrets.
#
# Copy to infra/.env and fill in real values:   cp infra/.env.example infra/.env
# infra/.env is gitignored (Principle IV). The `vault-init` one-shot service
# reads these and writes them into the dev Vault at secret/hireiq/dev, where
# backend & agents read them at startup via config.py.

# --- Required ---
OPENAI_API_KEY=sk-your-openai-key-here
JWT_SECRET=change-me-to-a-long-random-string
AGENTS_INTERNAL_SECRET=dev-internal-secret

# --- Email (optional; EMAIL_BACKEND=console logs to stdout in dev) ---
EMAIL_API_KEY=
EMAIL_FROM=noreply@hireiq.local

# --- Voice interview TTS fallback (optional) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
