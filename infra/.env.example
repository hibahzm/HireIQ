# HireIQ — local dev secrets.
#
# Copy to infra/.env and fill in real values:   cp infra/.env.example infra/.env
# infra/.env is gitignored (Principle IV). The `vault-init` one-shot service
# reads these and writes them into the dev Vault at secret/hireiq/dev, where
# backend & agents read them at startup via config.py.

# --- Required ---
OPENAI_API_KEY=sk-your-openai-key-here
JWT_SECRET=change-me-to-a-long-random-string
AGENTS_INTERNAL_SECRET=dev-internal-secret

# --- Email (optional; EMAIL_BACKEND=console logs to stdout in dev) ---
EMAIL_API_KEY=
EMAIL_FROM=noreply@hireiq.local

# --- Voice interview: streaming STT/TTS + TTS fallback (optional, Azure Speech F0) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Image/scanned-CV OCR (optional, Azure Document Intelligence F0) ---
# Needed for JPG/PNG CV uploads and scanned/text-light PDFs. Leave blank to use
# PDF/DOCX only. Get both from the Document Intelligence resource → Keys and Endpoint.
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

# --- LLM tracing (optional, Langfuse). Leave blank to disable tracing. ---
# Get keys from your Langfuse project settings (cloud.langfuse.com or self-hosted).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
